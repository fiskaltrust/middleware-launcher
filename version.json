{
  "$schema": "https://raw.githubusercontent.com/dotnet/Nerdbank.GitVersioning/main/src/NerdBank.GitVersioning/version.schema.json",
  "version": "2.0.0-rc.{height}",
  "buildNumberOffset": 27,
  "assemblyVersion": {
    "precision": "minor"
  },
  "publicReleaseRefSpec": [
    "^refs/tags/v\\d+(?:\\.\\d+)*(?:-.*)?$"
  ],
  "nugetPackageVersion": {
    "semVer": 2
  },
  "cloudBuild": {
    "buildNumber": {
      "enabled": true
    }
  },
  "release": {
    "tagName": "v{version}",
    "versionIncrement": "build",
    "firstUnstableTag": "ci"
  }
}
